# Ollama
OLLAMA_HOST=http://localhost:11434
# Candidato default en esta máquina (6 GB VRAM): qwen3:8b con thinking apagado
# automáticamente (lección de este repo). qwen2.5:7b era el anterior default.
OLLAMA_MODEL=qwen3:8b

# Proveedor de LLM: ollama | deepseek (default ollama)
# LLM_PROVIDER=deepseek
# DeepSeek (OpenAI-compatible) — LLM_MODEL aplica a ambos
DEEPSEEK_API_KEY=
# LLM_MODEL=deepseek-chat

# Tareas de calidad (write_email, value_page): usan DeepSeek si hay
# DEEPSEEK_API_KEY arriba; si no, el router cae al mismo modelo local.
# El selector de default queda en LLM_PROVIDER (ollama | deepseek).

# Search providers
# SEARCH_PROVIDER=auto | duckduckgo | bing-rss | serper | duckduckgo+bing-rss
# 'auto' (default): si hay SERPER_API_KEY arranca con serper y cae a duckduckgo/bing-rss;
# sin key cae a duckduckgo → bing-rss (gratis, pero ignoran operadores site:/comillas/OR).
# Para un lead mining serio, poné una key de https://serper.dev (free tier) y pegalo acá:
SEARCH_PROVIDER=serper
SERPER_API_KEY=
# SERPER_GL=mx (región de Google, default mx)

# Criterio de calificación (default: agencias de diseño web en México).
# Si buscás otro nicho, ajustá acá (separado por comas) y qualify_lead
# va a puntuar contra esto. Ejemplo nómina/RRHH:
# NMDA_CRITERIA_LABEL=Empresa señalando intención de comprar/cambiar software de nómina o RH en México
# NMDA_CRITERIA_LOCATIONS=mexico, cdmx, ciudad de mexico, mexico city
# NMDA_CRITERIA_INDUSTRIES=software, recursos humanos, hr tech, saas, tecnologia
# NMDA_CRITERIA_SERVICES=software de nómina, nómina, recursos humanos, rrhh, gestión de talento
# NMDA_CRITERIA_KEYWORDS=comprar, cambiar, implementar, evaluar, migrar, recomendación, comparación
# NMDA_CRITERIA_MIN_SCORE=45